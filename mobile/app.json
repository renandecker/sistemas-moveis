{
  "expo": {
    "name": "Móveis Pajé",
    "slug": "moveis-paje-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo-moveis-paje.png",
    "splash": {
      "image": "./assets/logo-moveis-paje.png",
      "resizeMode": "contain",
      "backgroundColor": "#101c1c"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moveispaje.mobile"
    },
    "android": {
      "package": "com.moveispaje.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-moveis-paje.png",
        "backgroundColor": "#101c1c"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
